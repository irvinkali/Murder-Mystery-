# --- Spoiler protection: never commit decoded plot content ---
# Any file that could contain decoded pack/plot text is forbidden in git.
*.decoded
*.plain
*.md.decoded
*.json.decoded
/tmp-decode/
packs/**/*.md
!docs/**/*.md
!README.md
!STATE.md

# Generated narration audio is radioactive (reveal audio speaks the killer).
# Never commit it — it is rendered at deploy time and served, never browsed.
engine/public/assets/narration/*.mp3
engine/public/assets/narration/*.wav

# Node / build
node_modules/
.netlify/
dist/
*.log
.env
.env.*
.DS_Store
